function analyzeMMTFLanguage(text) {
  const t=String(text||'').trim();
  if(!t) return {hits:[],features:['未填答'],dimensions:[],level:'E0',levelName:'無資料',limit:'沒有文字資料，不能進行語言判讀。',followup:'請確認是否願意補充具體工作經驗；不願回答亦應尊重。'};
  const lexicon=[
    {dim:'Mirror',terms:['不知道自己','沒注意到','沒想過','不了解自己','別人怎麼看','回饋','提醒我','自我認知']},
    {dim:'Matrix',terms:['權責不清','不知道誰負責','沒有權限','流程不清楚','制度規定','沒人處理','資源不足','分工不清']},
    {dim:'Flow',terms:['沒通知','沒有通知','沒有回覆','訊息落差','資訊不清楚','傳達錯誤','資訊不完整','交接延遲','沒有收到']},
    {dim:'Safety',terms:['不敢說','不敢提出','怕被罵','擔心被責備','不方便反映','講了也沒用','不敢反映','害怕提出','怕主管','不會有人聽'] }
  ];
  const hits=[];
  lexicon.forEach(group=>group.terms.forEach(term=>{if(t.includes(term))hits.push({term,type:'構面詞彙',dimension:group.dim});}));
  const featureRules=[
    {name:'否定／限制表述',terms:['不敢','不能','不會','沒有','沒辦法','無法','不方便','不想']},
    {name:'不確定表述',terms:['可能','大概','好像','應該','不太確定','或許']},
    {name:'絕對化／概括表述',terms:['都不','每次','永遠','從來','全部','大家都','一定']},
    {name:'主動行動表述',terms:['我主動','我提出','我反映','我詢問','我曾經回報','我會提出']},
    {name:'被動／外部處置表述',terms:['被要求','被告知','被忽略','被退回','被責備','被通知']},
    {name:'無效感／無力表述',terms:['沒用','沒有用','沒辦法改變','講了也沒用','不會改善']},
    {name:'具體事件線索',terms:['昨天','上週','上個月','某次','當時','會議','專案','主管','同事','部門','流程','客戶']}
  ];
  const features=[];
  featureRules.forEach(rule=>{if(rule.terms.some(term=>t.includes(term)))features.push(rule.name);});
  if(!features.length)features.push('未辨識到明確語態特徵');
  // Basic negation scope guard: avoid treating negated fear phrases as positive risk evidence.
  const negatedHits=hits.filter(h=>['不怕被罵','不擔心被責備','沒有不敢','並非不敢'].some(p=>t.includes(p)));
  const activeHits=hits.filter(h=>!negatedHits.includes(h));
  const dimensions=[...new Set(activeHits.map(h=>h.dimension))];
  const concrete=featureRules[6].terms.some(term=>t.includes(term));
  const explicitRisk=activeHits.some(h=>h.dimension==='Safety'&&['不敢說','不敢提出','怕被罵','擔心被責備','不方便反映','講了也沒用','不敢反映','害怕提出','怕主管','不會有人聽'].includes(h.term));
  const level=concrete&&activeHits.length?'E2':activeHits.length?'E1':'E0';
  const levelName=level==='E2'?'有具體情境線索（仍待查證）':level==='E1'?'初步語言線索':'資訊不足／未辨識明確線索';
  let limit='規則式詞彙比對無法理解完整語境、反諷、台語／口語變體或受試者真正意圖；須由顧問閱讀原文確認。';
  if(!activeHits.length)limit='目前回答沒有可支持構面判讀的明確詞彙；不能將簡短回答、沉默或未命中詞庫解讀為不願發聲或心理安全不足。';
  else if(explicitRisk)limit='出現與發聲受限相關的字詞，只能列為待查證線索；須確認事件、對象、頻率、後果及受試者原意。';
  const followup=explicitRisk?'請描述最近一次發生的具體情境：當時發生什麼事、你如何回應、擔心什麼後果，最後結果如何？':!activeHits.length?'你回答「'+(t.length>24?t.slice(0,24)+'…':t)+'」，可以再說明一個最近的工作例子嗎？若確實沒有相關經驗，也可以直接說明。':'請補充最近一次具體事件、涉及的工作流程／角色、當時採取的行動，以及後續處理結果。';
  return {hits:activeHits,features,dimensions,level,levelName,limit,followup};
}

function buildMMTFConsistencyStatement(dim,result){
  if(result.level==='E0')return `目前 ${dim.name} 分數為 ${dim.score}/25，但質性文字未提供足夠的構面證據；無法判定量化低分與回答是否一致。`;
  if(result.dimensions.includes(dim.name))return `文字中出現與 ${dim.name} 相關的語言線索，與量化結果呈現初步主題對應；目前僅為規則式辨識，仍須顧問核對原文與事件。`;
  return `目前辨識到的文字線索未明確對應 ${dim.name}；不能因此認定量化結果錯誤，應追問情境並檢查量表題項、受試者理解及其他資料來源。`;
}
