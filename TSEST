<script>
let currentUnlockedStage = 1;

function scrollToSection(id) {
  let targetSec = document.getElementById(id);
  if(!targetSec) return;
  
  // 檢查是否已解鎖
  let secIdNum = parseInt(id.replace('stage', '').replace('-sec', ''));
  if(secIdNum > currentUnlockedStage && secIdNum !== 3 && secIdNum !== 4 && secIdNum !== 5) {
    alert('請先完成前置階段填答與確認！');
    return;
  }
  targetSec.scrollIntoView({behavior: 'smooth'});
}

function handleHeaderAction() {
  if(currentUnlockedStage === 1) {
    scrollToSection('stage2-sec');
  } else if(currentUnlockedStage === 2) {
    runConsultantAnalysis();
  } else if(currentUnlockedStage === 3) {
    unlockStage4();
  } else if(currentUnlockedStage === 4) {
    unlockStage5();
  } else {
    scrollToSection('stage5-sec');
  }
}

function updateSingleDim(idPrefix, val, dimName, allScores) {
  let score5 = (val / 5).toFixed(1);
  document.getElementById('txt-' + idPrefix).innerHTML = `${val} / 25<br><span style="font-size:10px">(${score5} / 5)</span>`;
  
  let pill = document.getElementById('pill-' + idPrefix);
  let desc = document.getElementById('desc-' + idPrefix);

  let sorted = [...allScores].sort((a,b) => b.val - a.val);
  let isHighest = (val === sorted[0].val && val > sorted[3].val);
  let isLowest = (val === sorted[3].val && val < sorted[0].val);

  if (val === 25) {
    pill.className = "dim-pill p-high";
    pill.innerText = "完美";
    desc.innerHTML = `<b>${dimName}達標完美</b><br>該構面運作卓越，無明顯改善缺口。`;
  } else if (val >= 18) {
    pill.className = "dim-pill p-high";
    pill.innerText = isHighest ? "表現最佳" : "相對偏高";
    desc.innerHTML = `<b>${dimName}表現穩健</b><br>結構與執行具備良好水準，可作為組織支撐點。`;
  } else if (val >= 12) {
    pill.className = "dim-pill p-mid";
    pill.innerText = isHighest ? "相對最高" : "表現居中";
    desc.innerHTML = `<b>${dimName}具備基本雛形</b><br>絕對水準仍有優化空間。`;
  } else if (val >= 8) {
    pill.className = "dim-pill p-low";
    pill.innerText = isLowest ? "主要卡點" : "偏低";
    desc.innerHTML = `<b>${dimName}明顯不足</b><br>執行與落實受阻，需優先導入改善對策。`;
  } else {
    pill.className = "dim-pill p-low";
    pill.innerText = "嚴重偏低";
    desc.innerHTML = `<b>${dimName}極度匱乏</b><br>呈現嚴重斷層，對組織運作構成重大風險。`;
  }
}

function runSimulation() {
  let m = Math.min(25, Math.max(0, Number(document.getElementById('mirror').value)||0));
  let mx = Math.min(25, Math.max(0, Number(document.getElementById('matrix').value)||0));
  let f = Math.min(25, Math.max(0, Number(document.getElementById('flow').value)||0));
  let s = Math.min(25, Math.max(0, Number(document.getElementById('safe').value)||0));
  
  let total = m + mx + f + s;
  let avg = (total / 4 / 5).toFixed(2);
  
  let aw = Number(((m + s) / 2 / 5).toFixed(1));
  let ac = Number(((mx + f) / 2 / 5).toFixed(1));

  let ring = document.getElementById('total-ring');
  if(ring) {
    ring.style.background = `conic-gradient(#8a0bfa 0 ${total}%, #e2c2ff ${total}% 100%)`;
  }

  document.getElementById('v-total').innerText = total;
  document.getElementById('v-sum').innerText = total + ' / 100';
  document.getElementById('v-avg').innerText = avg + ' / 5';
  let r1Tag = document.getElementById('r1-tag');
  if(r1Tag) r1Tag.innerText = '總分 ' + total;

  let scores = [
    { key: 'm', name: 'Mirror (問題覺察)', val: m },
    { key: 'mx', name: 'Matrix (制度權責)', val: mx },
    { key: 'f', name: 'Flow (資訊流動)', val: f },
    { key: 's', name: 'Safety (心理安全)', val: s }
  ];

  updateSingleDim('m', m, '問題覺察機制', scores);
  updateSingleDim('mx', mx, '制度權責架構', scores);
  updateSingleDim('f', f, '資訊流動協作', scores);
  updateSingleDim('s', s, '心理安全氛圍', scores);

  let typeTitle = document.getElementById('v-type');
  let typeDesc = document.getElementById('v-type-desc');
  let obsContainer = document.getElementById('v-observations');

  scores.sort((a, b) => b.val - a.val);
  let highest = scores[0];
  let lowest = scores[3];

  if(total === 100) {
    typeTitle.style.color = "#00a86b";
    typeTitle.innerText = "完美運作型 (Optimal / Perfect)";
    typeDesc.innerText = "組織在所有構面皆達到完美滿分，四構面均衡發展且毫無落差，展現頂級的高效協作與組織韌性。";
    obsContainer.innerHTML = `<b>主要觀察：</b><ul><li>總分達 100 分滿分，四個構面全數達到完美水準（25/25）。</li></ul>`;
  } else if(total >= 75) {
    typeTitle.style.color = "#00a86b";
    typeTitle.innerText = "高效運作型 (Optimal)";
    typeDesc.innerText = "組織在各構面評分均衡且表現優異，資訊流動順暢、心理安全充足。";
    obsContainer.innerHTML = `<b>主要觀察：</b><ul><li>整體表現優異（總分 ${total}/100），表現最佳構面為 <b>${highest.name} (${highest.val}/25)</b>。</li></ul>`;
  } else if(total >= 50) {
    typeTitle.style.color = "#ff9700";
    typeTitle.innerText = "穩健發展中型 (Developing)";
    typeDesc.innerText = "組織具備基本結構，但在部分跨部門協作上仍有優化空間。";
    obsContainer.innerHTML = `<b>主要觀察：</b><ul><li>相對較高為 <b>${highest.name} (${highest.val}/25)</b>，卡點為 <b>${lowest.name} (${lowest.val}/25)</b>。</li></ul>`;
  } else {
    typeTitle.style.color = "#d93838";
    typeTitle.innerText = "高風險失能型 (Fragile)";
    typeDesc.innerText = "組織在各構面評分偏低，呈現結構與執行落差，需優先針對最弱環節介入。";
    obsContainer.innerHTML = `<b>主要觀察：</b><ul><li>總分偏低 (${total}/100)，最嚴重卡點落在 <b>${lowest.name} (${lowest.val}/25)</b>。</li></ul>`;
  }

  drawQuadrant(aw, ac, m, mx, f, s);

  window.lowestDimKey = lowest.key;
  window.lowestDimName = lowest.name;

