      const list=mmtfValidityRows.filter(r=>required.every(c=>r[c]!==''&&Number.isFinite(Number(r[c])))&&selectedCols.every(c=>r[c]!==''&&Number.isFinite(Number(r[c]))));
      const allowed=new Set(list.map(r=>r.case_id));
      const filtered=pairs.filter(p=>allowed.has(p.id));pairs.length=0;pairs.push(...filtered);
    }
    const r=corrValue(pairs.map(p=>p.x),pairs.map(p=>p.y),method);
    results.push({...measure,n:pairs.length,r,label:correlationLabel(r)});
  }
  const methodName=method==='pearson'?'Pearson 積差相關':'Spearman 等級相關';
  const rows=results.map(v=>`<tr><td>${v.construct}</td><td>${v.label}</td><td>${v.n}</td><td>${v.r===null?'—':v.r.toFixed(3)}</td><td>${v.label}</td></tr>`).join('');
