function rankValues(values){
  const sorted=values.map((v,i)=>({v,i})).sort((a,b)=>a.v-b.v);
  const ranks=Array(values.length);let i=0;
  while(i<sorted.length){let j=i+1;while(j<sorted.length&&sorted[j].v===sorted[i].v)j++;
    const rank=(i+1+j)/2;for(let k=i;k<j;k++)ranks[sorted[k].i]=rank;i=j;
  }return ranks;
}
function pearsonR(x,y){
  const n=x.length;if(n<3)return null;
  const mx=x.reduce((a,b)=>a+b,0)/n,my=y.reduce((a,b)=>a+b,0)/n;
  let num=0,dx=0,dy=0;
  for(let i=0;i<n;i++){const a=x[i]-mx,b=y[i]-my;num+=a*b;dx+=a*a;dy+=b*b;}
  if(dx===0||dy===0)return null;
  return num/Math.sqrt(dx*dy);
}
function corrValue(x,y,method){return method==='spearman'?pearsonR(rankValues(x),rankValues(y)):pearsonR(x,y);}
function correlationLabel(r){
  if(r===null)return '無法計算（樣本不足或變異為零）';
  const a=Math.abs(r);return a>=.7?'高度相關':a>=.4?'中度相關':a>=.2?'低度相關':'極低相關／接近無相關';
}
