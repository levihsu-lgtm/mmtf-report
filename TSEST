function parseMMTFCsv(text) {
  const lines=[]; let row=[], cell='', quoted=false;
  for(let i=0;i<text.length;i++){
    const ch=text[i], next=text[i+1];
    if(ch==='"' && quoted && next==='"'){cell+='"';i++;}
    else if(ch==='"'){quoted=!quoted;}
    else if(ch===',' && !quoted){row.push(cell);cell='';}
    else if((ch==='\n'||ch==='\r')&&!quoted){
      if(ch==='\r'&&next==='\n')i++;
      row.push(cell); if(row.some(v=>String(v).trim()!==''))lines.push(row);
      row=[];cell='';
    } else cell+=ch;
  }
  row.push(cell); if(row.some(v=>String(v).trim()!==''))lines.push(row);
  if(!lines.length) throw new Error('CSV 沒有資料');
  const headers=lines[0].map(h=>h.trim().replace(/^\uFEFF/,''));
  const rows=lines.slice(1).map(r=>{
    const obj={}; headers.forEach((h,i)=>obj[h]=(r[i]??'').trim()); return obj;
  });
  return {headers,rows};
}

