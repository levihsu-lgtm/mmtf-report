const $=id=>document.getElementById(id), val=id=>($(id)?.value||'').trim(), esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
function scores(){return {Mirror:Number($('mirror')?.value||0),Matrix:Number($('matrix')?.value||0),Flow:Number($('flow')?.value||0),Safety:Number($('safe')?.value||0)}}
function validScores(o){return Object.values(o).every(x=>Number.isFinite(x)&&x>=0&&x<=25)}
function saveState(){return {version:'2.1',diagnosis:{unit:val('m21-unit'),period:val('m21-period'),invited:val('m21-invited'),valid:val('m21-valid'),source:val('m21-source'),level:val('m21-level'),represent:val('m21-represent'),privacy:val('m21-privacy'),missing:val('m21-missing'),events:val('m21-events')},scores:scores(),formula:val('m21-formula'),cut:val('m21-cut'),archetype:{main:val('m21-archetype-main'),secondary:val('m21-archetype-secondary'),status:val('m21-archetype-status'),confidence:val('m21-confidence'),support:val('m21-archetype-support'),counter:val('m21-archetype-counter'),rationale:val('m21-archetype-rationale')},interview:{role:val('m21-interview-role'),date:val('m21-interview-date'),fact:val('m21-fact'),perception:val('m21-perception'),hypothesis:val('m21-hypothesis'),counter:val('m21-counter-evidence'),source:val('m21-evidence-source'),dimension:val('m21-lit-dimension')},raci:{R:val('m21-r'),A:val('m21-a'),C:val('m21-c'),I:val('m21-i')},plan:{goal:val('m21-goal'),resources:val('m21-resources'),proof:val('m21-proof'),kpi:val('m21-kpi')},followup:{t1:val('m21-t1'),t2:val('m21-t2'),comparable:val('m21-comparable'),events:val('m21-external-events')}}}
function renderArchetypes(){const el=$('m21-archetype-main');if(!el)return;el.innerHTML='<option value="">尚未選擇／暫不分類</option>'+archetypes.map(a=>`<option value="${a[0]}">${a[0]}｜${a[1]}</option>`).join('');el.addEventListener('change',()=>{const a=archetypes.find(x=>x[0]===el.value);$('m21-archetype-description').textContent=a?`${a[0]}｜${a[1]}：${a[2]} 此為工作假設，需以支持證據與反證覆核。`:'選擇原型後顯示手冊中的工作假設。';});}
window.MMTF21={
 auditData(){const n=Number(val('m21-invited')),v=Number(val('m21-valid'));let issues=[];if(!val('m21-unit'))issues.push('未填診斷單位');if(n<=0)issues.push('邀請人數未填或為零');if(v<0||v>n)issues.push('有效回收份數需介於 0 與邀請人數之間');if(val('m21-represent')!=='已檢查，分布可接受')issues.push('代表性尚未確認或存在偏差');if(val('m21-privacy')!=='已完成去識別與揭露檢查')issues.push('匿名與小樣本揭露保護尚未完成');if(val('m21-missing')==='尚未確認')issues.push('缺失值處理規則尚未確認');const rate=n>0?(v/n*100).toFixed(1):'—';$('m21-quality-result').innerHTML=`回收率：<b>${rate}%</b><br>${issues.length?'<b>待處理事項：</b><ul>'+issues.map(x=>`<li>${esc(x)}</li>`).join('')+'</ul>':'目前欄位檢核通過；仍須由顧問確認抽樣偏差及資料適切性。'}<br><span class="m21-sub">回收率不等於代表性；本檢核不自動判定資料品質合格。</span>`;},
 calculateProfile(){const s=scores();if(!validScores(s)){alert('四構面分數須為 0–25。');return;}let x,y,formula;if(val('m21-formula')==='proposal'){x=.5*s.Mirror+.5*s.Safety;y=.6*s.Matrix+.4*s.Flow;formula='提案權重：CSI=0.5M+0.5S；SDI=0.6Mx+0.4F';}else{x=(s.Mirror+s.Safety)/2;y=(s.Matrix+s.Flow)/2;formula='等權重試算：CSI=(M+S)/2；SDI=(Mx+F)/2';}let extra='未核定切點：僅呈現座標，不標示正式象限。';if(val('m21-cut')!=='none'){const c=Number(val('m21-cut'));extra=`暫用切點 ${c}：${x>=c?'CSI 高側':'CSI 低側'}／${y>=c?'SDI 高側':'SDI 低側'}（僅介面試算，不是常模或正式分類）。`;}const spread=Math.max(...Object.values(s))-Math.min(...Object.values(s));$('m21-profile-result').innerHTML=`<table class="m21-table"><tr><th>構面</th><th>分數／25</th></tr>${Object.entries(s).map(([k,v])=>`<tr><td>${k}</td><td>${v}</td></tr>`).join('')}<tr><th>總分（描述值）</th><td>${Object.values(s).reduce((a,b)=>a+b,0)}／100</td></tr><tr><th>CSI（X）</th><td>${x.toFixed(2)}／25</td></tr><tr><th>SDI（Y）</th><td>${y.toFixed(2)}／25</td></tr><tr><th>最高－最低構面差距</th><td>${spread} 分</td></tr></table><p>${esc(formula)}</p><p><b>${esc(extra)}</b></p><p class="m21-sub">構面落差需回到題項、部門分布與證據查核，不能由平均投影取代。</p>`;},
 showLiterature(){const d=val('m21-lit-dimension'),r=lit[d];$('m21-literature-result').innerHTML=`<div class="m21-note"><b>${esc(d)}｜文獻參照：</b>${esc(r.refs)}<br><b>可支持：</b>${esc(r.supports)}<br><b>推論界線：</b>${esc(r.limit)}</div>`;},
 generateActions(){const s=scores();const ranked=Object.entries(s).sort((a,b)=>a[1]-b[1]);const html=ranked.map(([k,v],i)=>`<div class="m21-task"><h4>${k}｜目前分數 ${v}/25 ${i===0?'（優先查證）':i===1?'（次優先查證）':''}</h4><p>${actions[k]}</p><p class="m21-sub">先以訪談、流程文件及管理紀錄確認根因，再核定介入。</p></div>`).join('');$('m21-actions-result').innerHTML=html;},
 create90DayPlan(){const stages=[['第 0–30 天','建立基準線、完成訪談與根因查證、核定責任人及資源。'],['第 31–60 天','執行優先改善措施，追蹤流程指標、員工回饋與副作用。'],['第 61–90 天','完成後測與結果指標檢查，決定維持、修正或擴大。']];$('m21-plan-result').innerHTML=stages.map((x,i)=>`<div class="m21-task"><h4>${x[0]}</h4><p>${x[1]}</p><p><b>目標：</b>${esc(val('m21-goal')||'待設定')}<br><b>資源：</b>${esc(val('m21-resources')||'待設定')}<br><b>完成證據：</b>${esc(val('m21-proof')||'待設定')}<br><b>結果指標：</b>${esc(val('m21-kpi')||'待設定')}</p><p><b>RACI：</b>R ${esc(val('m21-r')||'待指定')}｜A ${esc(val('m21-a')||'待指定')}｜C ${esc(val('m21-c')||'待指定')}｜I ${esc(val('m21-i')||'待指定')}</p></div>`).join('');},
 compareTimepoints(){const parse=t=>t.split(',').map(x=>Number(x.trim()));const a=parse(val('m21-t1')),b=parse(val('m21-t2'));if(a.length!==4||b.length!==4||[...a,...b].some(x=>!Number.isFinite(x)||x<0||x>25)){alert('T1、T2 請依 Mirror,Matrix,Flow,Safety 順序輸入四個 0–25 分數，以逗號分隔。');return;}const names=['Mirror','Matrix','Flow','Safety'];const rows=names.map((n,i)=>({n,a:a[i],b:b[i],d:b[i]-a[i]}));const comparable=val('m21-comparable')==='yes';$('m21-trend-result').innerHTML=`<table class="m21-table"><tr><th>構面</th><th>T1</th><th>T2</th><th>變化</th><th>方向</th></tr>${rows.map(r=>`<tr><td>${r.n}</td><td>${r.a}</td><td>${r.b}</td><td>${r.d>0?'+':''}${r.d}</td><td>${r.d>0?'分數上升':r.d<0?'分數下降':'未變動'}</td></tr>`).join('')}</table><p><b>比較條件：</b>${comparable?'已由使用者確認可比，仍需保存抽樣與施測證明。':'尚未確認可比，不宜將總分作完整前後測結論。'}</p><p><b>同期事件：</b>${esc(val('m21-external-events')||'未填寫')}</p><p>趨勢僅描述觀察變化，不代表統計顯著或介入因果。</p>`;},
 printReport(){const content=$('mmtf21-workflow').innerHTML;const w=window.open('','_blank');if(!w){alert('瀏覽器封鎖彈出視窗，請允許此頁開啟列印視窗。');return;}w.document.write('<html><head><meta charset="utf-8"><title>MMTF 2.1 顧問報告</title><style>body{font-family:Arial,"Noto Sans TC",sans-serif;padding:24px;color:#222}.m21-wrap{border:1px solid #ccc;padding:14px;margin:12px 0;break-inside:avoid}.m21-btn{display:none}.m21-table{border-collapse:collapse;width:100%}.m21-table td,.m21-table th{border:1px solid #aaa;padding:6px}.m21-note{background:#f5f5f5;padding:8px}</style></head><body><h1>MMTF 2.1 顧問報告</h1>'+content+'</body></html>');w.document.close();w.focus();w.print();},
 exportCSV(){const d=saveState();const rows=[['section','field','value']];function walk(o,p=''){Object.entries(o).forEach(([k,v])=>{if(v&&typeof v==='object')walk(v,p?`${p}.${k}`:k);else rows.push([p,k,String(v??'')]);});}walk(d);const csv='\ufeff'+rows.map(r=>r.map(v=>'"'+String(v).replace(/"/g,'""')+'"').join(',')).join('\r\n');download(csv,'mmtf21_case_export.csv','text/csv;charset=utf-8');},
 exportJSON(){download(JSON.stringify(saveState(),null,2),'mmtf21_case_backup.json','application/json');}
};
function download(data,name,type){const blob=new Blob([data],{type}),url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download=name;a.click();setTimeout(()=>URL.revokeObjectURL(url),1000);}
document.addEventListener('DOMContentLoaded',renderArchetypes);
})();

</script>
</body></html>
