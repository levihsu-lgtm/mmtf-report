  if(!measures.length){alert('請先選擇本次實際施測的外部量表；Safety 可同時選擇 Edmondson 與 PSC-12。');return;}
  const required=['case_id','mmtf_mirror','mmtf_matrix','mmtf_flow','mmtf_safety'];
  const selectedCols=[...new Set(measures.map(m=>m.column))];
  const missing=[...required.filter(c=>!mmtfValidityHeaders.includes(c)),...selectedCols.filter(c=>!mmtfValidityHeaders.includes(c))];
  if(missing.length){alert('CSV 缺少必要欄位：'+missing.join(', '));return;}
  const method=document.getElementById('validity-method').value;
  const alpha=Number(document.getElementById('validity-alpha').value);
  const missingMode=document.getElementById('validity-missing').value;
  const results=[];
  for(const measure of measures){
    const pairs=[];
    mmtfValidityRows.forEach(row=>{
      const id=row.case_id;
      const x=Number(row[measure.mmtf]), y=Number(row[measure.column]);
      const valid=String(id||'').trim()!==''&&row[measure.mmtf]!==''&&row[measure.column]!==''&&Number.isFinite(x)&&Number.isFinite(y);
      if(valid)pairs.push({id,x,y});
    });
