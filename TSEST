<!doctype html>
<html lang="zh-Hant"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>MMTF 2.0 模組化職涯顧問分析報告</title>
<style>
:root{--navy:#073f87;--purple:#521493;--green:#00a86b;--orange:#ff9700;--ink:#12345a;--pale:#faf5ff}
*{box-sizing:border-box}body{margin:0;background:var(--pale);font-family:"Microsoft JhengHei","PingFang TC",Arial,sans-serif;color:var(--ink);font-size:14px;line-height:1.5}
.top{background:linear-gradient(110deg,#3b1468,#6824b0 70%,#281048);color:#fff;padding:16px 24px;display:flex;align-items:center;gap:20px;flex-wrap:wrap;border-bottom:4px solid #b67afb}
.top h1{font-size:clamp(22px,2.5vw,32px);margin:0;white-space:nowrap}
.tagline{border-left:1px solid #c99bfc;padding-left:15px;font-size:14px;line-height:1.6;flex:1}
main{max-width:1650px;margin:auto;padding:16px}

/* 階段按鈕與流程指引列 */
.stage-nav-bar{display:flex;align-items:center;justify-content:space-between;background:linear-gradient(135deg,#f4eaff,#ebd4ff);border:1px solid #c89bff;border-radius:12px;padding:12px 18px;margin-bottom:16px;gap:10px;flex-wrap:wrap}
.stage-pill{display:flex;align-items:center;gap:8px;font-weight:bold;color:#521493;font-size:13px;background:#fff;padding:8px 14px;border-radius:20px;border:1px solid #d5bcff;cursor:pointer;transition:all 0.2s}
.stage-pill:hover{background:#f3e8ff;border-color:#521493}
.stage-pill span{width:24px;height:24px;background:#521493;color:white;border-radius:50%;display:grid;place-items:center;font-size:12px}
.stage-arrow{color:#7012ca;font-weight:900;font-size:16px}
.next-btn{background:#521493;color:white;border:none;border-radius:8px;padding:10px 18px;cursor:pointer;font-weight:bold;font-size:13px;box-shadow:0 2px 5px rgba(82,20,147,0.3)}
.next-btn:hover{background:#6d1ac7}
.export-btn{background:linear-gradient(120deg,#00a86b,#20d2a0);color:white;border:none;border-radius:8px;padding:10px 18px;cursor:pointer;font-weight:bold;font-size:13px;box-shadow:0 2px 5px rgba(0,168,107,0.3)}
.export-btn:hover{background:#008f5a}

/* 模組通用樣式 */
.module-box{background:#fff;border:1px solid #d5bcff;border-radius:14px;padding:20px;margin-bottom:16px;box-shadow:0 4px 12px rgba(82,20,147,0.06)}
.module-title{font-size:18px;font-weight:900;color:#521493;margin-bottom:14px;display:flex;align-items:center;gap:10px;border-bottom:2px solid #f3e8ff;padding-bottom:8px}

/* 輸入面板 */
.inputs-container{display:flex;flex-direction:column;gap:12px;margin-bottom:16px}
.inputs-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}
.input-card{padding:12px 16px;border-radius:10px;color:#fff;display:flex;align-items:center;justify-content:space-between;font-size:14px}
.input-card input{width:65px;padding:6px;border:1px solid #ddd;border-radius:6px;font-weight:bold;font-size:16px;color:#15365d;text-align:center}
.m-mirror{background:linear-gradient(110deg,#00a86b,#20d2a0)}
.m-matrix{background:linear-gradient(110deg,#087cf3,#32b9ff)}
.m-flow{background:linear-gradient(110deg,#ff8500,#ffc34e)}
.m-safe{background:linear-gradient(110deg,#8a0bfa,#cf85ff)}
.gen-btn{background:linear-gradient(120deg,#07528f,#087cf3);color:white;border:none;border-radius:8px;padding:12px;font-weight:900;cursor:pointer;font-size:15px;width:100%}

/* 一排三張卡片區塊 */
.report-panel-grid{display:grid;grid-template-columns:1fr 1fr 1.35fr;gap:16px;align-items:stretch}
.r-card{background:linear-gradient(135deg,#fcf8ff,#fff);border:1px solid #d5bcff;border-radius:12px;padding:16px;display:flex;flex-direction:column;min-width:0}

.r-card-head{background:linear-gradient(100deg,#f3eafc,#fff 88%);padding:10px 12px;border-bottom:3px solid #9a4efe;display:flex;align-items:center;gap:8px;color:#521493;font-weight:900;font-size:13.5px;margin-bottom:12px;border-radius:6px}
.r-num{width:26px;height:26px;display:inline-grid;place-items:center;border-radius:50%;background:#521493;color:white;font-size:13px;flex-shrink:0}

/* 診斷摘要內部排版 */
.summary-top{display:flex;align-items:center;gap:16px;margin-bottom:12px}
.ring{width:80px;height:80px;border-radius:50%;display:grid;place-items:center;background:conic-gradient(#8a0bfa 0 0%,#e2c2ff 0% 100%);position:relative;flex-shrink:0;transition:background 0.3s ease}
.ring:before{content:"";position:absolute;inset:8px;background:white;border-radius:50%}
.ring div{position:relative;text-align:center}
.ring strong{font-size:22px;color:#7012ca;display:block;line-height:1}
.ring small{font-size:12px;font-weight:bold}
.fragile-box b{font-size:15px;display:block;margin-bottom:4px}
.fragile-box p{font-size:13px;color:#444;margin:0;line-height:1.5}
.stats-row{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:12px}
.stat-box{background:#f4eaff;padding:8px;border-radius:8px;text-align:center;border:1px solid #e0c5ff}
.stat-box b{display:block;font-size:12px;color:#521493}
.stat-box strong{font-size:15px;color:#7012ca}
.sub-box{font-size:13px;line-height:1.5}
.sub-box ul{padding-left:18px;margin:6px 0}

/* 四構面列表 */
.dim-row{display:grid;grid-template-columns:85px 70px 60px minmax(0,1fr);gap:6px;align-items:center;padding:8px 6px;margin-bottom:8px;border-radius:8px;background:#fff;border:1px solid #ecdffc}
.dim-name{padding:6px 4px;color:white;border-radius:6px;font-weight:bold;font-size:11.5px;text-align:center}
.dim-score{font-size:12.5px;font-weight:900;text-align:center;line-height:1.2}
.dim-pill{padding:4px 4px;text-align:center;color:white;font-weight:bold;border-radius:4px;font-size:11px}
.p-low{background:#f34550}.p-mid{background:#ff9700}.p-high{background:#00a86b}
.dim-desc{font-size:11.5px;color:#444;padding-left:4px;line-height:1.4}

/* 第三張卡片內部：上圖表、下說明 */
.card3-stack{display:flex;flex-direction:column;gap:14px;height:100%}
.plot-wrap-stacked{width:100%;display:flex;align-items:center;justify-content:center}
#quadrantChart{display:block;width:100%;height:auto;max-height:420px}

/* 下方說明面板 */
.bottom-info-panel{background:#f8f4ff;border:1.5px solid #d5bcff;border-radius:10px;padding:12px;display:flex;flex-direction:column;gap:10px}
.b-panel-head{background:#521493;color:#fff;padding:6px 12px;border-radius:6px;text-align:center;font-size:14px;font-weight:900}
.b-panel-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.b-info-box{background:#fff;border:1px solid #ebdffc;border-radius:6px;padding:8px 10px;font-size:12px;line-height:1.5}
.b-info-title{font-size:12.5px;font-weight:900;color:#521493;margin-bottom:4px;border-bottom:1px solid #f3e8ff;padding-bottom:2px}
.b-formula-box{padding:10px 12px;font-size:12.5px;line-height:1.55}
.b-formula-detail{padding-left:14px;color:#65409a}
.b-score-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.b-score-card{background:#fff;border:1px solid #ebdffc;border-radius:7px;padding:8px;text-align:center}
.b-score-label{font-size:12px;color:#6b5388;font-weight:800;font-style:italic}
.b-score-value{font-size:22px;line-height:1.25;color:#c94b61;font-weight:900}
.b-score-value small{font-size:11px;color:#9b7180}
.b-current-quad{background:#7012ca;color:#fff;border-radius:6px;padding:8px 10px;text-align:center;font-size:13px;font-weight:900}
.b-reading-box{padding:9px 11px}
.b-reading-line{display:flex;gap:6px;margin:5px 0;line-height:1.45;font-size:11.8px}
.b-reading-line span{color:#7b35c9;font-weight:900;flex:0 0 auto}

/* 質性填答欄位 */
.qual-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.qual-group{background:#f9f5ff;padding:14px;border-radius:10px;border:1px solid #e2cffc}
.qual-group label{display:block;font-weight:bold;color:#521493;margin-bottom:6px;font-size:13px}
.qual-group textarea{width:100%;height:85px;padding:10px;border:1px solid #d5bcff;border-radius:8px;font-family:inherit;font-size:13px}

/* 模組三表格 */
.analysis-table{width:100%;border-collapse:collapse;font-size:13px;margin-top:10px}
.analysis-table th{background:#521493;color:white;padding:10px;text-align:left}
.analysis-table td{padding:10px;border:1px solid #ebdffc;vertical-align:top;background:#fff;line-height:1.5}

/* 模組四 6 大繽紛區塊 */
.report-grid-6{display:grid;grid-template-columns:repeat(auto-fit, minmax(320px, 1fr));gap:14px}
.report-card{border-radius:12px;padding:16px;border:1px solid #e0ebf5}
.rc-1{background:linear-gradient(145deg,#f0fff8,#fff);border-color:#bcebd7}
.rc-2{background:linear-gradient(145deg,#f4fbff,#fff);border-color:#b9dfff}
.rc-3{background:linear-gradient(145deg,#fff7e9,#fff);border-color:#f5d5a4}
.rc-4{background:linear-gradient(145deg,#f6efff,#fff);border-color:#d7c8ff}
.rc-5{background:linear-gradient(145deg,#fff0f4,#fff);border-color:#ffcbd8}
.rc-6{background:linear-gradient(145deg,#f4f6ff,#fff);border-color:#c8d4ff}
.rc-title{font-size:14px;font-weight:900;color:#174875;margin-bottom:8px;display:flex;justify-content:space-between;align-items:center}
.rc-title span{background:#521493;color:#fff;padding:3px 8px;border-radius:4px;font-size:11px}
.report-card p{font-size:13px;line-height:1.5;margin:0}
.personal-report-content{font-size:13px;line-height:1.65;color:#23415f}
.personal-report-content .pr-intro{margin:0 0 8px}
.personal-report-content .pr-metric-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;margin:9px 0}
.personal-report-content .pr-metric{background:rgba(255,255,255,.82);border:1px solid #e4eaf2;border-radius:8px;padding:8px}
.personal-report-content .pr-metric b{display:block;font-size:19px;color:#521493}
.personal-report-content .pr-list{margin:6px 0 0;padding-left:18px}
.personal-report-content .pr-list li{margin:4px 0}
.personal-report-content .pr-dim{padding:7px 0;border-bottom:1px solid #e7edf5}
.personal-report-content .pr-dim:last-child{border-bottom:0}
.personal-report-content .pr-muted{font-size:11px;color:#64748b}
.personal-report-content .pr-chip{display:inline-block;border-radius:4px;padding:2px 7px;background:#f0e8ff;color:#521493;font-size:11px;font-weight:800;margin:2px 3px 2px 0}
.personal-report-content .pr-action{padding:8px;margin:7px 0;background:#fff;border:1px solid #eadff8;border-radius:7px}
.personal-report-content .pr-quote{padding:7px 9px;margin:6px 0;background:rgba(255,255,255,.8);border-left:3px solid #a78bfa;border-radius:4px;white-space:pre-wrap;overflow-wrap:anywhere}
@media(max-width:700px){.personal-report-content .pr-metric-grid{grid-template-columns:1fr 1fr}}

/* 第五階段覆盤樣式 */
.stage5-box{background:linear-gradient(135deg,#f3eafc,#fff);border:2px dashed #9a4efe;border-radius:12px;padding:16px;margin-top:16px}
.stage5-grid{display:grid;grid-template-columns:repeat(4, 1fr);gap:10px;margin-top:10px}
.stage5-input{background:#fff;border:1px solid #d5bcff;border-radius:8px;padding:10px;text-align:center}
.stage5-input input{width:60px;padding:4px;font-weight:bold;text-align:center;font-size:15px;border:1px solid #ccc;border-radius:4px}

@media(max-width:1250px){.report-panel-grid{grid-template-columns:1fr}.inputs-grid{grid-template-columns:1fr 1fr}.stage5-grid{grid-template-columns:1fr 1fr}}
@media(max-width:850px){.qual-grid{grid-template-columns:1fr}.b-panel-grid{grid-template-columns:1fr}}
@media(max-width:550px){.inputs-grid{grid-template-columns:1fr}.stage5-grid{grid-template-columns:1fr}}
</style></head><body>

<header class="top">
  <h1>MMTF 2.0 模組化職涯顧問分析報告</h1>
  <div class="tagline">模組一：圖像診斷 ➔ 模組二：因材施教填答 ➔ 模組三：顧問交叉分析與對策 ➔ 模組四：個人報告與文獻摘要 ➔ 模組五：持續追蹤與覆盤</div>
</header>

<main>
  <!-- 階段導引列（可點擊跳轉，右側動態按鈕） -->
  <div class="stage-nav-bar">
    <div style="font-weight:900;color:#521493">顧問諮詢執行進度導引：</div>
    <div class="stage-pill" onclick="scrollToSection('stage1-sec')"><span>1</span>數據與圖像呈現</div>
    <div class="stage-arrow">➔</div>
    <div class="stage-pill" onclick="scrollToSection('stage2-sec')"><span>2</span>動態質性填答</div>
    <div class="stage-arrow">➔</div>
    <div class="stage-pill" id="nav-stage3" onclick="scrollToSection('stage3-sec')"><span>3</span>顧問交叉分析 (待填答)</div>
    <div class="stage-arrow">➔</div>
    <div class="stage-pill" id="nav-stage4" onclick="scrollToSection('stage4-sec')"><span>4</span>總結與建議 (待解鎖)</div>
    <div class="stage-arrow">➔</div>
    <div class="stage-pill" id="nav-stage5" onclick="scrollToSection('stage5-sec')"><span>5</span>永續覆盤 (待解鎖)</div>
    <button class="next-btn" id="header-action-btn" onclick="handleHeaderAction()">進入第二階段 ➔</button>
  </div>

  <!-- 模組一：原始數據輸入與分析呈現 -->
  <section class="module-box" id="stage1-sec">
    <div class="module-title"><span>📦</span> 模組一：輸入四構面分數與 MMTF 2.0 顧問報告結果</div>
    
    <div class="inputs-container">
      <div class="inputs-grid">
        <div class="input-card m-mirror"><span>◉</span><div><b>Mirror</b><small style="display:block;font-size:11px">問題覺察與回饋</small></div><input id="mirror" type="number" value="9" min="0" max="25" oninput="runSimulation()"></div>
        <div class="input-card m-matrix"><span>♙</span><div><b>Matrix</b><small style="display:block;font-size:11px">制度與權責資源</small></div><input id="matrix" type="number" value="13" min="0" max="25" oninput="runSimulation()"></div>
        <div class="input-card m-flow"><span>●</span><div><b>Flow</b><small style="display:block;font-size:11px">資訊流動與協作</small></div><input id="flow" type="number" value="8" min="0" max="25" oninput="runSimulation()"></div>
        <div class="input-card m-safe"><span>♟</span><div><b>Safety</b><small style="display:block;font-size:11px">心理安全與員工意見</small></div><input id="safe" type="number" value="5" min="0" max="25" oninput="runSimulation()"></div>
      </div>
      <button class="gen-btn" onclick="runSimulation()">送出並更新報告 ⚡</button>
    </div>

    <!-- 一排三張卡片區塊 -->
    <div class="report-panel-grid">
      <!-- 卡片 1 -->
      <div class="r-card">
        <div class="r-card-head"><span class="r-num">1</span>診斷摘要 <small>總分、四構面結果、主要觀察與限制</small></div>
        <div class="summary-top">
          <div class="ring" id="total-ring"><div><strong id="v-total">35</strong><small>/ 100</small></div></div>
          <div class="fragile-box">
            <b id="v-type">高風險失能型 (Fragile)</b>
            <p id="v-type-desc">組織在制度結構面評分中低，但在問題覺察、資訊流動與心理安全明顯不足，呈現結構與執行落差。</p>
          </div>
        </div>
        <div class="stats-row">
          <div class="stat-box"><b>整體平均</b><strong id="v-avg">1.75 / 5</strong></div>
          <div class="stat-box"><b>四構面總分</b><strong id="v-sum">35 / 100</strong></div>
        </div>
        <div class="sub-box" id="v-observations">
          <!-- JS 動態更新主要觀察 -->
        </div>
      </div>

      <!-- 卡片 2 -->
      <div class="r-card">
        <div class="r-card-head"><span class="r-num">2</span>四構面分析 <small>各構面分數與實際意義</small></div>
        <div id="dim-list">
          <div class="dim-row">
            <div class="dim-name" style="background:#00a86b">Mirror<small style="display:block;font-size:9.5px">問題覺察</small></div>
            <div class="dim-score" id="txt-m">9 / 25<br><span style="font-size:10px">(1.8 / 5)</span></div>
            <div class="dim-pill p-low" id="pill-m">偏低</div>
            <div class="dim-desc" id="desc-m"><b>問題覺察不足</b><br>盲點較多，回饋通道受阻</div>
          </div>
          <div class="dim-row">
            <div class="dim-name" style="background:#087cf3">Matrix<small style="display:block;font-size:9.5px">制度權責</small></div>
            <div class="dim-score" id="txt-mx">13 / 25<br><span style="font-size:10px">(2.6 / 5)</span></div>
            <div class="dim-pill p-mid" id="pill-mx">相對居中</div>
            <div class="dim-desc" id="desc-mx"><b>制度具備基本雛形</b><br>權責配置尚可但落實度待加強</div>
          </div>
          <div class="dim-row">
            <div class="dim-name" style="background:#ff8500">Flow<small style="display:block;font-size:9.5px">資訊流動</small></div>
            <div class="dim-score" id="txt-f">8 / 25<br><span style="font-size:10px">(1.6 / 5)</span></div>
            <div class="dim-pill p-low" id="pill-f">偏低</div>
            <div class="dim-desc" id="desc-f"><b>資訊傳遞受阻</b><br>跨部門協作弱，容易產生雜訊</div>
          </div>
          <div class="dim-row">
            <div class="dim-name" style="background:#9218ef">Safety<small style="display:block;font-size:9.5px">心理安全</small></div>
            <div class="dim-score" id="txt-s">5 / 25<br><span style="font-size:10px">(1.0 / 5)</span></div>
            <div class="dim-pill p-low" id="pill-s">嚴重偏低</div>
            <div class="dim-desc" id="desc-s"><b>表達意見保守</b><br>信任氛圍不足，發聲意願低</div>
          </div>
        </div>
      </div>

      <!-- 卡片 3 -->
      <div class="r-card">
        <div class="r-card-head"><span class="r-num">3</span>組織效能四象限圖 (Awareness × Action) 與本次數據落點判讀</div>
        <div class="card3-stack">
          <div class="plot-wrap-stacked">
            <svg id="quadrantChart" viewBox="0 0 660 540" role="img" aria-label="依四構面分數動態定位的四象限圖"></svg>
          </div>
          <div class="bottom-info-panel" id="card3-bottom-info">
            <!-- JS 動態更新 -->
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 模組二：因材施教（根據各項分數組合動態派發質性深掘題） -->
  <section class="module-box" id="stage2-sec">
    <div class="module-title"><span>📦</span> 模組二：因材施教（依據四構面分數組合動態派發之質性深掘題）</div>
    <p style="margin:0 0 10px 0;color:#6b5388;font-size:14px" id="qual-dynamic-notice">系統已根據您當前的四構面分數組合，自動鎖定最關鍵的落差進行提問：</p>
    
    <div class="qual-grid">
      <div class="qual-group">
        <label id="dyn-label-1"><b>Q1 核心深掘題：</b></label>
        <textarea id="qual-ans-1" placeholder="請填寫您的職場情境..."></textarea>
      </div>
      <div class="qual-group">
        <label id="dyn-label-2"><b>Q2 輔助驗證題：</b></label>
        <textarea id="qual-ans-2" placeholder="請填寫您的職場情境..."></textarea>
      </div>
    </div>
    <div class="module-box" id="lpa-preview" style="margin-top:14px;border-color:#8b5cf6">
      <div class="module-title">🔎 MMTF-LPA｜語言線索與語態分析</div>
      <p style="font-size:12px;color:#6b5388">分析原始文字中的構面關鍵詞、否定／不確定／絕對化語句、主動／被動表述及具體事件線索。這是規則式文字提示，不判斷人格、心理狀態或真實意圖；所有結論仍須由顧問核對。</p>
      <div id="lpa-live-result" style="background:#faf7ff;border:1px solid #e3d5ff;border-radius:8px;padding:10px">提交填答後，系統將顯示語言線索、證據等級及需要追問的地方。</div>
    </div>
    <div style="margin-top:12px">
